# 脚本在 Linux/macOS 上必须为 LF，否则 bash/python 会解析失败
*.sh   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
# Windows 脚本保持 CRLF（PowerShell/cmd 均兼容，UTF-8 BOM 不受影响）
*.ps1  text eol=crlf
*.bat  text eol=crlf
# 二进制资源不做换行转换
*.png  binary
*.jpg  binary
*.ico  binary
*.icns binary
*.woff2 binary
